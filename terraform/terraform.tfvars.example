# Example Terraform Variables File
# Copy to terraform.tfvars and fill with real GCP Project details (do NOT commit secrets).

project_id        = "your-gcp-project-id"
region            = "us-central1"
bfa_gateway_image = "gcr.io/your-gcp-project-id/irc-a-gateway:latest"
app_image         = "gcr.io/your-gcp-project-id/fortified-healthcare-fleet:latest"
gemini_api_key    = "your_gemini_api_key_here"
openai_api_key    = "your_openai_api_key_here"
bfa_api_key       = "bfa_gcp_hackathon_demo_key_2026"
